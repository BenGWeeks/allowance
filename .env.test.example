# LNBits Test Environment Configuration
# Copy this file to .env.test and fill in your actual values
# .env.test is gitignored and will not be committed

# Test Environment
TEST_LNBITS_URL=https://your-lnbits-instance.com

# Sending Wallet (where allowances are paid from)
TEST_SENDING_WALLET_ID=your-sending-wallet-id-here
TEST_SENDING_WALLET_KEY=your-sending-wallet-api-key-here

# Receiving Wallet (where payments are received)
TEST_RECEIVING_WALLET_ID=your-receiving-wallet-id-here
TEST_RECEIVING_WALLET_KEY=your-receiving-wallet-api-key-here

# Admin credentials for UI tests
TEST_ADMIN_USERNAME=your-username
TEST_ADMIN_PASSWORD=your-password
