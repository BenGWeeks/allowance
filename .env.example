# Example environment configuration for testing
# Copy to .env.local and update with your values

# LNBits instance URL
TEST_LNBITS_URL=http://localhost:5001

# Admin credentials
LNBITS_ADMIN_USERNAME=your_username
LNBITS_ADMIN_PASSWORD=your_password

# Test wallet configuration
RECEIVING_WALLET_NAME=Receiving

# Lightning address for testing payments
PAYLINK_EMAIL=your_lightning_address@example.com
